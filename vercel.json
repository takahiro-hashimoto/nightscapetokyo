{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "crons": [
    {
      "path": "/api/revalidate/?mode=daily",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/luminar/sale-sync/",
      "schedule": "0 22 * * *"
    }
  ]
}

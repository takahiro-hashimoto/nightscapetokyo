# Cloudflare Workers のローカル実行用（wrangler dev / opennextjs-cloudflare preview）
# 実値は .env.local からコピーする。このファイル自体はコミットしてよい雛形。
NEXTJS_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# R2（画像配信・管理画面のアップロード用。ISRキャッシュ用バケットとは別）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# 外部 API
ANTHROPIC_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
WEATHERAPI_KEY=
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_VERSION=
AMAZON_CREATORS_PARTNER_TAG=

# 管理画面・再検証
ADMIN_EMAILS=
CRON_SECRET=
REVALIDATE_SECRET=
